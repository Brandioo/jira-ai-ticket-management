DB_USERNAME=db
DB_PASSWORD=db

CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

FRONTEND_URL=http://localhost:5173

OLLAMA_ENABLED=false
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
